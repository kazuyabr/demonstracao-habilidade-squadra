# =============================================================================
# Enterprise Order Platform - Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values
# NEVER commit .env to version control!

# =============================================================================
# SQL Server
# =============================================================================
SQLSERVER_SA_PASSWORD=REPLACE_WITH_ENV_VARIABLE

# =============================================================================
# MongoDB
# =============================================================================
MONGODB_USERNAME=your_mongodb_username
MONGODB_PASSWORD=your_mongodb_password

# =============================================================================
# Keycloak
# =============================================================================
KEYCLOAK_ADMIN_USER=your_keycloak_admin_user
KEYCLOAK_ADMIN_PASSWORD=your_keycloak_password
KEYCLOAK_DEMO_PASSWORD=your_demo_password
KEYCLOAK_URL=http://localhost:18180

# =============================================================================
# Frontend (dev server with hot reload)
# =============================================================================
# The frontend-dev service (http://localhost:13004) uses these values. Point the
# redirect URI at the port you open in the browser (13004 by default).
FRONTEND_DEV_REDIRECT_URI=http://localhost:13004/callback

# Demo credentials shown on the login screen (baked into the local build only;
# never committed). Set to the same value as KEYCLOAK_DEMO_PASSWORD so visitors
# can sign in with the demo account right away.
REACT_APP_DEMO_USERNAME=demouser
REACT_APP_DEMO_PASSWORD=your_demo_password

# =============================================================================
# Grafana
# =============================================================================
GRAFANA_ADMIN_USER=your_grafana_admin_user
GRAFANA_ADMIN_PASSWORD=your_grafana_password

# =============================================================================
# Application Databases
# =============================================================================
ORDER_DB_PASSWORD=your_order_db_password
PAYMENT_DB_PASSWORD=your_payment_db_password
SAGA_DB_PASSWORD=your_saga_db_password

# =============================================================================
# Optional Host Ports (leave empty to keep services internal to Docker)
# =============================================================================
# Databases and messaging are not exposed on the host by default. They remain
# reachable inside the Docker network by service name. Set a host port to reach
# them directly from your machine (e.g. SSMS, MongoDB Compass, Pulsar admin):
#
#   SQLSERVER_HOST_PORT=11433
#   MONGODB_HOST_PORT=17017
#   PULSAR_BROKER_HOST_PORT=16650
#   PULSAR_ADMIN_HOST_PORT=18090
#
SQLSERVER_HOST_PORT=
MONGODB_HOST_PORT=
PULSAR_BROKER_HOST_PORT=
PULSAR_ADMIN_HOST_PORT=

# =============================================================================
# Azure (for production deployment)
# =============================================================================
# ARM_CLIENT_ID=your_azure_client_id
# ARM_CLIENT_SECRET=your_azure_client_secret
# ARM_SUBSCRIPTION_ID=your_azure_subscription_id
# ARM_TENANT_ID=your_azure_tenant_id
