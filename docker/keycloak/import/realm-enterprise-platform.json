{
  "realm": "enterprise-platform",
  "enabled": true,
  "displayName": "Enterprise Order Platform",
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "roles": {
    "realm": [
      {
        "name": "CUSTOMER",
        "description": "Regular customer with read access to orders"
      },
      {
        "name": "OPERATOR",
        "description": "Operator with order management capabilities"
      },
      {
        "name": "ADMIN",
        "description": "Administrator with full platform access"
      }
    ]
  },
  "clients": [
    {
      "clientId": "enterprise-order-platform",
      "enabled": true,
      "publicClient": true,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "authorizationServicesEnabled": false,
      "protocol": "openid-connect",
      "redirectUris": [
        "http://localhost:13003/*",
        "http://localhost:13004/*"
      ],
      "webOrigins": [
        "http://localhost:13003",
        "http://localhost:13004"
      ],
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "profile",
        "roles",
        "email"
      ],
      "optionalClientScopes": [
        "address",
        "phone",
        "offline_access",
        "microprofile-jwt"
      ]
    }
  ],
  "defaultRoles": [
    "CUSTOMER"
  ],
  "browserSecurityHeaders": {
    "contentSecurityPolicy": "frame-src 'self'; frame-ancestors 'self'; object-src 'none';"
  },
  "smtpServer": {},
  "eventsEnabled": true,
  "eventsListeners": [
    "jboss-logging"
  ],
  "adminEventsEnabled": true,
  "adminEventsDetailsEnabled": true
}
